{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ph.Sh-Packs manifest v1",
  "type": "object",
  "required": ["manifest_version", "pack_id", "family", "version", "issued", "license", "files"],
  "properties": {
    "manifest_version": { "const": 1 },
    "pack_id": {
      "type": "string",
      "pattern": "^(network|detection|hunt)\\.[a-z0-9-]+$",
      "description": "<family>.<slug> — family is one of network|detection|hunt"
    },
    "family": { "enum": ["network", "detection", "hunt"] },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version — every content change bumps the version and is re-signed"
    },
    "min_app_version": { "type": "string", "description": "Minimum simplewall-fork version able to consume this pack" },
    "issued": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "license": { "enum": ["CC-BY-4.0"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "Upstream intel sources for the content — empty only allowed for placeholder builds",
      "items": {
        "type": "object",
        "required": ["name", "retrieved"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "license": { "type": "string" }
        }
      }
    },
    "expires_hint_days": { "type": "integer", "minimum": 1, "maximum": 365 }
  }
}
